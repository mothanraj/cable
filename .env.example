APP_ENV=development

PORT=5000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=customer_management
DB_USER=postgres
DB_PASSWORD=
DB_SSLMODE=prefer

# Supabase (Session pooler) example:
# DB_HOST=aws-0-<region>.pooler.supabase.com
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres.<project-ref>
# DB_PASSWORD=<supabase-db-password>
# DB_SSLMODE=require

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Comma-separated list of allowed client origins.
# In development, any localhost/127.0.0.1 port is also allowed.
CLIENT_URL=http://localhost:5173,http://localhost:5174
